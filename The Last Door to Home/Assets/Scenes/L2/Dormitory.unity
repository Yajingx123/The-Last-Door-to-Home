MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1329084529}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c32c00f83df28a349973c5a0fdf4608d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogues:
  - The rubbish bin. Inside there are some notes written by Jeff.
  - '''They would not understand.



    They would call it a hallucination. A neurochemical
    response. An abnormal exposure symptom that must be reported and stopped.'''
  - "\u2018But I have not dreamed of her in a long time.\r\n\r\nBut out here, so
    far from home, if a it can let me see her again, I do not want to hand it over.\r\n\r\nI
    can control it.\u2019"
  - "\u2018It is quiet.\r\n\r\nIt only watches me.\u2019"
  showDialogueImage: 1
  dialogueImageSprite: {fileID: 21300000, guid: 5657b0e86d4587746b9c3556db91b61d, type: 3}
