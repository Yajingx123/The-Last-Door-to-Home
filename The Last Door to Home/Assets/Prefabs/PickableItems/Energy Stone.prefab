  itemUniqueID: stone02
  itemName: Second Energy Stone
  itemType: 4
  itemDescription: "The backup energy source in the control room. \nTo activate the
    teleportation portal, three energy stones are required."
  itemIcon: {fileID: 1594065612, guid: 5c328cca3a25f01498602ba3270590cb, type: 3}
  itemIconResourcePath: ItemIcons/Key_items#controlroom2_1
  prePickDialogues:
  - 'The backup energy source in the control room. To activate the teleportation
    portal, three energy stones are required.


    Are you sure?'
  pickOptionText: Pick Up
  leaveOptionText: Cancel
  afterPickOptionDialogues:
  - 'You pick the stone.

    Now you have two stones, if Amelia brought back the
    last one, you can activate the portal again.'
  afterLeaveOptionDialogues:
  - You leave the stone in the cabinet.
